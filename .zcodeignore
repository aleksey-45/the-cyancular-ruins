# Godot 4+ specific ignores
.godot/
/android/

# Claude
.claude/

# 编辑器缓存与导入残留
*.import.bak
*.tmp
*.log

# 临时文件与备份
*.bak
*~
*.swp

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器工具产物
editor/_build/

# 构建产物与杂项
*.exe
test

# 发布/备份产物(不入库;版本号见 builds 内文件名与 RELEASE.md)
builds/
backup/

# 服务端开服时落盘的本机 IP(ServerMain._write_ip_file;机器专属,不该入库)
local_ip.txt

# Python 字节码缓存(tools/ 下的脚本被 import 时会生成)
__pycache__/

# 本机残留(旧线工具/日志看守/编辑器配置;不属于上游工程)
DevTools/
gamelogs/
.zcode/
.mimosa/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
