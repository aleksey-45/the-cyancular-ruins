; ★ 底板样式不再写在场景里(原先的 StyleBoxFlat 副本已删):由 ui/hud/pvp_hud.gd 的 _ready
;   调 UiFactory.hud_plate 统一给(C_PLATE + content margin 24/8)。C_PLATE 的唯一源仍只有
;   ui/factory/ui_factory.gd —— 场景结构上引用不到 GDScript const,所以样式不下沉进 .tscn。
; ★ 版式 = HUD 例外(anchors + offset,token 口径见 docs/systems/presentation/ui-design-system.md §5):
;   居顶元素锚 top-center(anchor 0.5)、右下延迟条锚 bottom-right;偏移全是锚点相对值
;   (16 = SP_4、72 = SP_9+SP_2、-24 = -MARGIN),禁止从 1920×1440 反推坐标。

[node name="PvpHud" type="CanvasLayer"]
layer = 130
script = ExtResource("1")

; 中央广播(遮罩 + 居中大字/副文案)已抽成共享组件 —— 三个对局 HUD 逐字相同的那一份。
; ★ 它**必须是第一个子节点**:Mask 要画在记分条**之下**(节点顺序 = 绘制顺序,这是现状,
;   照搬不改)。★ `.new()` 建出来的是空 Control、什么都画不出(且不报错) ⇒ 只能实例化场景。
;   组件的层位随本 HUD(layer 130),它**不是**独立 CanvasLayer(见 ui/hud/broadcast.gd 文件头)。
[node name="Broadcast" parent="." instance=ExtResource("3")]

; 记分条垫深底板:它对局中直接压在地图上,地图开阔区是浅灰蓝 —— 浅色文字压上去读不清。
; 底板由 PanelContainer 按内容撑开(不是把 Label 拉成一条 1240 宽的横条),故包一层 wrapper;
; 底板样式由 pvp_hud.gd 的 _ready 调 UiFactory.hud_plate 给(本节点不写 theme_override_styles)。
[node name="ScoreWrap" type="PanelContainer" parent="."]
anchor_left = 0.5
anchor_right = 0.5
offset_top = 16.0
grow_horizontal = 2
grow_vertical = 1
mouse_filter = 2

[node name="ScoreLabel" type="Label" parent="ScoreWrap"]
