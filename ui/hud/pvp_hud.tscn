theme_override_font_sizes/font_size = 32
theme_override_fonts/font = ExtResource("2")
text = ""
horizontal_alignment = 1

; 「对手掉线中」(阶段 3,spec §4 的 3.1)。★ 与记分条共用**同一个** UiFactory.hud_plate 样式
;   ⇒ 场景里零 bg_color 字面量。
;   ★ 颜色**不在这里写**:由 ui/pvp_hud.gd 的 _ready 从 UiFactory.C_GRACE 取(调色板单一来源)。
;   ★ 位置:记分条(offset_top 16 = SP_4,实测高 52、占 y ∈ [16, 68])之下,offset_top = 72 = SP_9+SP_2
;     —— 本条自占 y ∈ [72, 124](高 52 = 标签 36 + 底板上下各 8);状态横幅(layer 140)在 128。
;     ★ 那个 36 是"本条含 CJK 的文案"量出来的,不是"本项目字体在 32 下的行高":Label 行高 =
;     max(字体在该字号的 get_height, 整形 ascent+descent),两半都随内容变 —— 纯拉丁那行实测 33,
;     所以共用同款底板的 PingWrap(只有 "24ms")实得 49 而不是 52,同一张图里就差这 3px。
;     ★ 读数出处与 128 的推导(含大乱斗排行榜那 60px 侵入的登记)在 docs/systems/presentation/ui.md
;     「状态横幅的几何与层位」;代码侧只留 status_banner.gd 的 TOP_OFFSET 常量本身。
