[gd_scene format=3 uid="uid://killcounter00001"]

; 右上角击杀计数器的骨架:只有面板 + Label(初始 000)。
; 锚点(right)、偏移(SP_6 / SP_4)与「不画底色」的底板样式全部由 ui/hud/hud.gd 的
; _build_kill_label 按 token 设置 —— .tscn 结构上引用不到 GDScript const,写进来就是第二处真值。
[node name="KillCounter" type="PanelContainer"]
mouse_filter = 2

[node name="KillLabel" type="Label" parent="."]
text = "000"
