[gd_scene load_steps=3 format=3]

; 暂停菜单(设计系统 v1 / M4):保留 CanvasLayer + Control 叠加层(暂停菜单要原地开合、要暂停 tree、
; 不能用 AcceptDialog 的独立模态窗口语义 —— 契约 §5 括号里的例外),皮肤全部走 Theme 2.0:
; Card 面板 + H2 标题 + Primary/Quiet 按钮。场景只留结构,颜色/间距 token 在 pause_menu.gd 里设置。
[ext_resource type="Script" path="res://ui/screens/pause_menu.gd" id="1_pm"]
[ext_resource type="Theme" path="res://ui/theme/menu_theme.tres" id="2_theme"]

[node name="PauseMenu" type="CanvasLayer"]
layer = 145
process_mode = 3
script = ExtResource("1_pm")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
visible = false

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dialog" type="PanelContainer" parent="Root/Center"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="Body" type="VBoxContainer" parent="Root/Center/Dialog"]
layout_mode = 2

[node name="Header" type="Label" parent="Root/Center/Dialog/Body"]
layout_mode = 2
theme_type_variation = &"H2"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Root/Center/Dialog/Body"]
layout_mode = 2
theme_type_variation = &"Primary"
text = "继 续 游 戏"

[node name="Back" type="Button" parent="Root/Center/Dialog/Body"]
layout_mode = 2
theme_type_variation = &"Quiet"
text = "回 到 主 菜 单"
