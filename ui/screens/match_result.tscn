[gd_scene load_steps=3 format=3]

; 结算页(设计系统 v1 / M4):CanvasLayer + Control 叠加层(对局结束后的全屏结算,不是确认弹层),
; 皮肤全走 Theme 2.0:Card 面板 + H1/Dim 标题 + Primary 返回按钮;分区由 match_result.gd 用 UiKit.section 建。
; ★ 修复旧版「绝对布局」:面板不再用 anchor=0.5 + 代码算 offset_* 居中,改成 CenterContainer 居中;
;   颜色/间距 token 在 match_result.gd 里设置。
[ext_resource type="Script" path="res://ui/screens/match_result.gd" id="1_mr"]
[ext_resource type="Theme" path="res://ui/theme/menu_theme.tres" id="2_theme"]

[node name="MatchResult" type="CanvasLayer"]
layer = 150
visible = false
script = ExtResource("1_mr")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Root/Center"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="VBox" type="VBoxContainer" parent="Root/Center/Panel"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Root/Center/Panel/VBox"]
layout_mode = 2
