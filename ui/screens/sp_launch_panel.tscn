[gd_scene format=3 uid="uid://splaunchpanel001"]

; 单人开局面板的**骨架**:只有根节点(锚点 / 名字 / 定位)。
; ★ 内容与样式一律由 `scenes/main_menu.gd` 的 `_fill_sp_panel()` 建 —— 这里是**有意**留空的:
;   · 皮(凿刻边 + 内亮线)只能走 `UiFactory.skin_menu_panel()` —— `.tscn` 里的 StyleBoxFlat
;     颜色是**字面量**,而本项目「颜色只许在 ui_factory.gd 定义」(调色板单一来源守卫
;     `ui_palette_single_source_smoke` 扫全仓,含 .tscn)。
;   · 控件一律走 UiFactory(像素字体/字号规范/按钮三档配色的单一来源),在这里写 Label/Button
;     等于把那条纪律散回场景文件里。
; 于是场景只负责"这块面板怎么被摆到屏幕中央"。
[node name="SpLaunchPanel" type="PanelContainer"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
