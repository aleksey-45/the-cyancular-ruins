class_name TimeParams
extends RefCounted

# 时间系统（第一阶段 v0.5.0）全局参数配置表 —— 策划案 §2.1「时间粒子」经济系统的参数单一来源。
# 分层约定（参见 AGENTS.md 参数体系）：全局共享使用 GameParameters；玩家参数使用 PlayerParams；
# 敌人参数使用 EnemyParams；武器数值使用各 tscn 的 @export；时间玩法参数统一集中于本文件（静态访问，如 TimeParams.GRAIN_INITIAL）。
# 数值调整集中于此，与业务逻辑解耦，调整参数无需修改核心逻辑代码。

# ── 时间粒子账户（§2.1）────────────────────────────────────────────
const GRAIN_INITIAL := 1000       # 初始粒子数量
const GRAIN_CAP := 5000           # 粒子总额度上限（怀表白色短指针指示满圈）
const SHORT_WINDOW := 400.0       # 短期使用额度（红色长指针一圈；记录短期内累计消耗，恢复时反向回退）
const SHORT_REGEN := 50.0         # 短期额度恢复速率（粒子/秒；优先偿还透支额度，还清后再恢复短期额度）
const LOAN_LIMIT := 100.0         # 透支额度上限 = 红色长指针额外 1/4 圈（短期额度的 1/4）

# ── 技能消耗（§3.1）────────────────────────────────────────────
const COST_REWIND := 120.0        # 时空回溯消耗速率（粒子/秒，按住 Shift 触发）
const COST_HASTE := 80.0          # 时间加速消耗速率（粒子/秒，按住鼠标右键触发）

# ── 世界快照与时空回溯（第一阶段回溯）──────────────────────────────
const SNAP_HZ := 20               # 快照采样频率（Hz）
const SNAP_SECONDS := 40.0        # 环形缓冲区容量（秒），即最大可回溯历史时长
const REWIND_START_MULT := 3.0    # 回溯初始回放倍率（营造快速倒流效果，随后平滑过渡至 1.0×）
const REWIND_RAMP_TIME := 0.35    # 初始倍率过渡至 1.0× 的持续时间（秒）

# ── 时间加速相对倍率（主角 ×2.0，环境与普通实体 ×0.5）──────────────────
# 机制说明：主角视角时间加速，其余世界实体相对减速。玩家与精英实体倍率为 2.0（包含移动、换弹、
# 射击、冲刺、游泳与攀爬）；普通敌人、敌方子弹及掉落物等世界物体倍率为 0.5。相对速度差为 4 倍，
# 不修改全局 time_scale（确保物理引擎模拟、补间动画与网络同步不受干扰）。
const HASTE_PLAYER := 2.0         # 玩家与精英实体的行动倍率
const HASTE_WORLD := 0.5          # 其余一切实体（普通敌人、敌方子弹、掉落物）的倍率

# ── 透支状态的环境反馈（透支程度越深，效果越明显）─────────────────
const LOAN_ENEMY_SPEED_BONUS := 0.5    # 敌人相对速度加成上限（透支深度为 1 时敌人相对速度 ×1.5，表现为自身感知变慢）
const LOAN_PITCH_RANGE := 0.5          # 全局音效音调加成上限（透支深度为 1 时音调 ×1.5）
const LOAN_BRIGHT_RANGE := 0.35        # 画面提亮上限（Shader 亮度叠加增益）
const LOAN_ABERRATION_PX := 5.0        # 色彩分离/色差偏移上限（像素，透支深度为 1 时达到最大偏移）

# ── 乌鸫精英（§3.5.2）──────────────────────────────────────────
const ELITE_GRAIN_DROP := 300     # 击杀单只掉落的时间粒子数量

