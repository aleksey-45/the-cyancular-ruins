# Godot 4+ specific ignores
.godot/
/android/

# Claude
.claude/

# 编辑器缓存与导入残留
*.import.bak
*.tmp
*.log

# 临时文件与备份
*.bak
*~
*.swp

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器工具产物
editor/_build/

# 构建产物与杂项
*.exe
*.dll
test

# 第三方二进制:EasyTier(可选的联机隧道组件,见 tools/fetch_easytier.py 与 docs/netplay.md)
# ★ 必须连 Packet.dll / wintun.dll 一起放才有用(easytier-core.exe 静态导入 Packet.dll),
#   而 *.exe 那条盖不住 dll ⇒ 单独忽略整个目录。运行期生成的公共节点列表(relay.txt)也在里面。
/easytier/

# 运行期日志:客户端 / 服务端 / EasyTier 三方都写进这里(见 core/config/game_log.gd)
/log/

# 发布/备份产物(不入库;版本号见 builds 内文件名与 RELEASE.md)
builds/
backup/

# 旧的服务端本机 IP 落盘(local_ip.txt)。★ 那份机制的写入方 `_write_ip_file` **已删**
# (单进程改造后服务端不再写文件),这条规则留着只是防历史文件被误提交。
local_ip.txt

# Python 字节码缓存(tools/ 下的脚本被 import 时会生成)
__pycache__/

# 本机残留(旧线工具/日志看守/编辑器配置;不属于上游工程)
DevTools/
gamelogs/
.zcode/
.mimosa/

# 魔改版 EasyTier 的配置持久化目录(按 cwd 生成,不入库)
config.d/
