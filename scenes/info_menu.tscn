[gd_scene load_steps=3 format=3]

; 信息页静态骨架:**只有根节点**。版式与内容全部由 scenes/info_menu.gd 的 _build_ui()/
; _fill_commits() 用 UiKit + UiFactory 建(设计系统 v1 契约 .tmp/ui-system-contract.md §4/§5):
;   · 页面零绝对坐标:根 Control 全屏 → UiKit.page 的 Margin(SP_6)→VBox(SP_5);
;   · 颜色/字号/间距只引 UiFactory token,不把 Color 字面量散回 .tscn;
;   · 分区 = UiKit.card(H2 标题),不再手拼 PanelCarved / HeaderStrip 旧变体。
[ext_resource type="Script" path="res://scenes/info_menu.gd" id="1_info"]
[ext_resource type="Theme" path="res://ui/theme/menu_theme.tres" id="2_theme"]

[node name="InfoMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_info")
